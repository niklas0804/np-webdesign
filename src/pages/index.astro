---
/**
 * Startseite „Maßarbeit“ (Auftrag 11. Oktober 2026, Teil C). Sieben Abschnitte, der orange Faden als Werkzeug durch alle:
 * S1 Hero · S2 Warum · S3 Vergleich · S4 Beispiele · S5 Zusammenarbeit · S6 Kontakt · S7 FAQ und Footer.
 * Übergänge mit Staffelstab: S2 → S3 (N-Blende), S5 → S6 (P-Iris). Die neun Welten wohnen auf /welten.
 * Die Startseite lädt nur ihre eigenen Module (src/motion/home/).
 */
import Base from '../layouts/Base.astro';
import '../styles/frame.css';
import '../styles/sections.css';
import '../styles/home.css';
import '../styles/kontakt.css';
import { homeJourney } from '../config/journey.js';
import { SITE, PACKAGES } from '../config/site.js';
import Frame from '../components/Frame.astro';
import Menu from '../components/Menu.astro';
import Hero from '../home/Hero.astro';
import Warum from '../home/Warum.astro';
import Vergleich from '../home/Vergleich.astro';
import Beispiele from '../home/Beispiele.astro';
import Transition from '../components/Transition.astro';
import Zusammenarbeit from '../home/Zusammenarbeit.astro';
import Kontakt from '../components/Kontakt.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

const row = Object.fromEntries(homeJourney.map((r) => [r.id, r]));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    founder: { '@type': 'Person', name: SITE.owner },
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressRegion: 'Bayern', addressCountry: 'DE' },
    areaServed: ['Schwandorf', 'Regensburg', 'Amberg', 'Weiden', 'Oberpfalz'],
    priceRange: `${PACKAGES[0].price} – ${PACKAGES[PACKAGES.length - 1].price}`,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: 'de-DE' },
];
---
<Base
  title="Webdesign aus Schwandorf – Websites für Betriebe"
  description="Individuelle Websites für Betriebe in der Oberpfalz – entworfen und gebaut von Niklas Prüfling in Schwandorf, ohne Baukasten."
  path="/"
  jsonLd={jsonLd}
>
  <nav class="skiplinks" aria-label="Sprungmarken">
    <a href="#main">Zum Inhalt springen</a>
    <a href="#kontakt">Direkt zum Kontakt</a>
  </nav>

  <Frame page="home" />
  <Menu />

  <main id="main" data-page="home">
    <Hero row={row.start} />
    <Warum row={row.warum} />
    <Transition row={row['t-warum-vergleich']} />
    <Vergleich row={row.vergleich} />
    <Beispiele row={row.beispiele} />
    <Zusammenarbeit row={row.arbeitsweise} />
    <Transition row={row['t-arbeitsweise-kontakt']} />
    <Kontakt row={row.kontakt} />
    <Faq row={row.faq} />
  </main>

  <Footer />
  <script>
    import '../motion/home/index.js';
  </script>
</Base>
