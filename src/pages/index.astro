---
/**
 * Startseite. VORLÄUFIG (Teil B des Auftrags vom 11. Oktober 2026): Teil C ersetzt sie durch die neue Startseite („Maßarbeit“).
 * Bis dahin: Kopf, Warum, Arbeitsweise, Kontakt, FAQ, Footer. Die neun Welten wohnen auf /welten.
 */
import Base from '../layouts/Base.astro';
import '../styles/frame.css';
import '../styles/sections.css';
import '../styles/kontakt.css';
import { homeRows } from '../config/journey.js';
import { SITE, PACKAGES } from '../config/site.js';
import Frame from '../components/Frame.astro';
import Menu from '../components/Menu.astro';
import HeroVorlaeufig from '../components/HeroVorlaeufig.astro';
import Warum from '../components/Warum.astro';
import Arbeitsweise from '../components/Arbeitsweise.astro';
import Kontakt from '../components/Kontakt.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

const row = Object.fromEntries(homeRows.map((r) => [r.id, r]));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    founder: { '@type': 'Person', name: SITE.owner },
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressRegion: 'Bayern', addressCountry: 'DE' },
    areaServed: ['Schwandorf', 'Regensburg', 'Amberg', 'Weiden', 'Oberpfalz'],
    priceRange: `${PACKAGES[0].price} – ${PACKAGES[PACKAGES.length - 1].price}`,
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: 'de-DE' },
];
---
<Base
  title="Webdesign aus Schwandorf – Websites für Betriebe"
  description="Individuelle Websites für Betriebe in der Oberpfalz – entworfen und gebaut von Niklas Prüfling in Schwandorf, ohne Baukasten."
  path="/"
  jsonLd={jsonLd}
>
  <nav class="skiplinks" aria-label="Sprungmarken">
    <a href="#main">Zum Inhalt springen</a>
    <a href="#kontakt">Direkt zum Kontakt</a>
  </nav>

  <Frame page="home" />
  <Menu />

  <main id="main" data-page="home">
    <HeroVorlaeufig />
    <Warum row={row.warum} />
    <Arbeitsweise row={row.arbeitsweise} />
    <Kontakt row={row.kontakt} />
    <Faq row={row.faq} />
  </main>

  <Footer />
  <script>
    import '../motion/index.js';
  </script>
</Base>
