---
/**
 * /welten: Die Reise durch neun Welten (Auftrag 11. Oktober 2026). Werkplan → Welten 01–09 mit Übergängen → Finale.
 * Reihenfolge, Längen und Paletten kommen aus src/config/journey.js (Blueprint N, T.3). Die Seite wird indexiert.
 * Ein DOM, echter Text in Lesereihenfolge; Bühne und Rahmen liegen für Hilfstechnik verborgen darüber.
 */
import Base from '../layouts/Base.astro';
import '../styles/frame.css';
import '../styles/opening.css';
import '../styles/sections.css';
import '../styles/finale.css';
import { journey } from '../config/journey.js';
import { SITE } from '../config/site.js';
import Frame from '../components/Frame.astro';
import Menu from '../components/Menu.astro';
import Opening from '../components/Opening.astro';
import Transition from '../components/Transition.astro';
import World01 from '../worlds/01-halmberg/World.astro';
import World02 from '../worlds/02-messingstuhl/World.astro';
import World03 from '../worlds/03-wittgenfeld/World.astro';
import World04 from '../worlds/04-haas-sternfeld/World.astro';
import World05 from '../worlds/05-chromwerk/World.astro';
import World06 from '../worlds/06-jana-ahrens/World.astro';
import World07 from '../worlds/07-torquel/World.astro';
import World08 from '../worlds/08-praxis-am-weiher/World.astro';
import World09 from '../worlds/09-gut-weidenstein/World.astro';
import Finale from '../components/Finale.astro';
import Footer from '../components/Footer.astro';

const worldModules = { '01': World01, '02': World02, '03': World03, '04': World04, '05': World05, '06': World06, '07': World07, '08': World08, '09': World09 };
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage',
    name: 'Neun Welten · Studien von NP Webdesign', url: `${SITE.url}/welten`, inLanguage: 'de-DE',
    description: 'Neun erfundene Betriebe, neun völlig verschiedene Websites: Studien von NP Webdesign aus Schwandorf.',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
];
---
<Base
  title="Neun Welten · Studien von NP Webdesign"
  description="Neun erfundene Betriebe, neun völlig verschiedene Websites: Studien von NP Webdesign. Keine sieht aus wie die andere."
  path="/welten"
  image="/images/social/welten.jpg"
  jsonLd={jsonLd}
>
  <div class="skiplinks">
    <a href="#main">Zum Inhalt springen</a>
    <a href="/#kontakt">Zum Kontakt auf der Startseite</a>
  </div>

  <Frame page="welten" />
  <Menu />

  <main id="main" data-page="welten">
    {journey.map((row) => {
      if (row.kind === 'opening') return <Opening />;
      if (row.kind === 'transition') return <Transition row={row} />;
      if (row.kind === 'world') { const W = worldModules[row.world]; return <W row={row} />; }
      if (row.kind === 'finale') return <Finale row={row} />;
      return null;
    })}
  </main>

  <Footer />
  <script>
    import '../motion/index.js';
  </script>
</Base>
