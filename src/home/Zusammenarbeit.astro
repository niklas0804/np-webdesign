---
/**
 * S5 · So arbeiten wir zusammen (Auftrag 11. Oktober 2026, Teil C). Leinen. Sechs Schritte aus dem Copy-Deck (src/config/site.js, STEPS).
 * Der orange Faden zeichnet sich scrollgesteuert durch die Stationen; jede hat ein eigenes Linien-Piktogramm, das sich selbst zeichnet (SVG, je höchstens zwölf Pfade).
 * Der Faden endet mit einer Schlaufe (Betreuung); aus ihr wird im Übergang der Bauch des P (P-Iris).
 * Desktop quer und gepinnt, mobil senkrecht ohne Pin. Ruhig und ohne JavaScript: alles steht gezeichnet da.
 */
import { STEPS } from '../config/site.js';
const { row } = Astro.props;
// Piktogramme: 64 × 64, nur Linien. Jeder Pfad trägt pathLength="1" (Selbstzeichnen über stroke-dashoffset).
const PICS = [
  // 1 Kennenlernen: zwei Sprechlinien (zwei Sprechblasen mit je einer Textlinie)
  ['M6 10 H38 Q42 10 42 14 V28 Q42 32 38 32 H20 L12 40 V32 H10 Q6 32 6 28 V14 Q6 10 6 10 Z', 'M13 18 H34', 'M13 25 H27', 'M26 40 V44 Q26 48 30 48 H46 L54 56 V48 H56 Q58 48 58 44 V30 Q58 26 54 26 H46', 'M34 38 H50'],
  // 2 Konzeption: Wireframe-Kästen
  ['M8 10 H56 V54 H8 Z', 'M8 22 H56', 'M20 22 V54', 'M26 32 H50', 'M26 40 H44', 'M12 14 H30'],
  // 3 Design: „Ag“
  ['M6 50 L20 14 L34 50', 'M11 38 H29', 'M54 32 A9 9 0 1 0 54 32.01', 'M56 24 V50 Q56 58 47 58 Q41 58 39 54'],
  // 4 Entwicklung: </> wird eine Seite
  ['M20 22 L8 34 L20 46', 'M36 16 L28 52', 'M44 22 L56 34 L44 46', 'M14 6 H42 L54 18 V58 H14 Z', 'M42 6 V18 H54', 'M22 30 H44', 'M22 38 H44', 'M22 46 H36'],
  // 5 Launch: der Rahmen füllt sich
  ['M8 10 H56 V54 H8 Z', 'M8 20 H56', 'M12 50 H52'],
  // 6 Betreuung: der Faden schlägt eine Schlaufe (wird auf der Startseite vom Faden selbst gezeichnet, siehe zusammenarbeit.js)
  ['M2 32 H12 C26 32 30 10 44 10 C58 10 62 32 50 42 C40 52 22 46 28 30 C32 20 50 22 62 28'],
];
---
<section id={row.anchor} class="zs" data-section={row.id} data-counter={row.label} data-ground={row.ground} data-tone={row.tone} aria-labelledby="zs-title" data-zs>
  <div class="zs-track" data-zs-track>
    <div class="zs-stage" data-zs-stage>
      <svg class="zs-thread" aria-hidden="true" focusable="false" data-zs-thread><path class="zs-thread-path" pathLength="1" d="" /></svg>
      <div class="zs-head">
        <p class="kicker">Zusammenarbeit</p>
        <h2 id="zs-title" class="zs-title">So arbeiten wir zusammen.</h2>
      </div>
      <ol class="zs-steps" data-zs-steps>
        {STEPS.map((s, i) => (
          <li class="zs-step" data-zs-step>
            <span class={`zs-pic${i === 5 ? ' zs-loop' : ''}`} aria-hidden="true" data-zs-pic>
              <svg viewBox="0 0 64 64" focusable="false">{PICS[i].map((d) => <path class="zs-p" pathLength="1" d={d} />)}</svg>
            </span>
            <span class="mono zs-nr">{s.nr}</span>
            <h3 class="zs-h">{s.title}</h3>
            <p class="zs-t">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="zs-after">
    <p class="zs-close">Von der ersten Skizze bis nach dem Launch: ein Ansprechpartner.</p>
    <a class="btn btn-secondary" href="/leistungen"><span class="btn-label"><span>Pakete und Preise</span><span aria-hidden="true">Pakete und Preise</span></span></a>
      </div>
    </div>
  </div>
</section>
