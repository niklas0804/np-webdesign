---
/**
 * Übergang zwischen zwei Welten (Blueprint T.3, Auftrag 11. Oktober 2026, Teil A/B).
 * Die Bühne liegt unter den Welten und wird von ihnen auf- und zugedeckt; über den Welten liegt die Ebene des Staffelstabs (`.t-baton`):
 * Das Objekt der Übergabe ist ein echtes Element der alten Welt, wird dort abgeholt und am Ende auf das Gegenstück der neuen Welt gelegt.
 * Ruhige Variante und ohne JavaScript: nur der Faden als feine Linie, kein Pin.
 */
import { builtWorlds } from '../config/journey.js';
const { row } = Astro.props;
// NP-Zeichen (Welt 09 → Finale): die Akzentfarben der neun Welten, in Reihenfolge
const colors = row.variant === 'npzeichen' ? builtWorlds.map((w) => w.palette.accent).join(',') : undefined;
---
<section class="transition" data-section={row.id} data-from-tone={row.fromTone} data-to-tone={row.toTone}
         data-from-ground={row.fromGround} data-to-ground={row.toGround} data-from-id={row.from} data-to-id={row.to} data-variant={row.variant || undefined} data-colors={colors} aria-hidden="true">
  <div class="t-stage">
    <div class="t-wipe"></div>
    <div class="t-thread"></div>
    {row.variant === 'wasser' && (
      <svg class="t-ws-line" viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path data-t-wsline d="M0 6 C120 0 240 12 360 6 S600 0 720 6 S900 12 1000 6" pathLength="1" /></svg>
    )}
  </div>
  <div class="t-baton"><div class="t-baton-in" data-t-layer></div></div>
</section>
