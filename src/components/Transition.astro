---
/**
 * Standard-Übergang (Blueprint T.3): Der orange Faden zieht eine Linie quer über den Viewport,
 * dahinter wischt die neue Welt herein. Länge kommt aus der Reise-Konfiguration.
 * Ruhige Variante: nur der Faden als feine Linie, kein Pin.
 */
import BildPlatzhalter from './BildPlatzhalter.astro';
import WorldStill from './WorldStill.astro';
import Logo from './Logo.astro';
import { builtWorlds } from '../config/journey.js';
const { row } = Astro.props;
const TAGE = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
// Beispielmonat: 31 Tage, der erste ist ein Mittwoch; der gebuchte Termin ist der 17.
const ZELLEN = Array.from({ length: 35 }, (_, i) => { const tag = i - 2 + 1; return tag >= 1 && tag <= 31 ? tag : null; });
---
<section class="transition" data-section={row.id} data-from-tone={row.fromTone} data-to-tone={row.toTone}
         data-from-ground={row.fromGround} data-to-ground={row.toGround} data-from-id={row.from} data-to-id={row.to} data-variant={row.variant || undefined} aria-hidden="true">
  <div class="t-stage">
    <div class="t-wipe"></div>
    <div class="t-thread"></div>
    {row.variant === 'goldlinie' && (
      <div class="t-mass" data-t-mass>
        <div class="t-gold" data-world="02" data-t-gold></div>
        <div class="t-blue" data-world="03" data-t-blue></div>
        <div class="t-dim" data-world="03" data-t-dim>
          <svg class="t-arrow t-arrow-l" viewBox="0 0 40 40" aria-hidden="true"><path d="M36 14 L8 20 L36 26 Z" /><path d="M6 6 V34" /></svg>
          <span class="t-dim-value">12.400</span>
          <svg class="t-arrow t-arrow-r" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 14 L32 20 L4 26 Z" /><path d="M34 6 V34" /></svg>
        </div>
      </div>
    )}
    {row.variant === 'pruefstempel' && (
      <>
        <div class="t-iris" data-t-iris></div>
        <div class="t-seal" data-world="03" data-t-seal>
          <svg viewBox="0 0 160 160" focusable="false">
            <defs><path id="t-ring" d="M80 80 m-58 0 a58 58 0 1 1 116 0 a58 58 0 1 1 -116 0" /></defs>
            <g class="t-seal-ring" data-t-ringgroup>
              <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="4" />
              <text class="t-ring-text" data-t-ring-a><textPath href="#t-ring" startOffset="0" textLength="362" lengthAdjust="spacing">WITTGENFELD BAU · STUDIE · DEMO · </textPath></text>
              <text class="t-ring-text" data-t-ring-b><textPath href="#t-ring" startOffset="0" textLength="362" lengthAdjust="spacing">GEPRÜFT: KEIN BAUKASTEN · NP WEBDESIGN · </textPath></text>
            </g>
            <circle cx="80" cy="80" r="40" fill="none" stroke="currentColor" stroke-width="1.5" />
            <text class="t-seal-main" data-t-main-a x="80" y="88" text-anchor="middle">GEPRÜFT</text>
            <text class="t-seal-np" data-t-main-b x="80" y="94" text-anchor="middle">NP</text>
          </svg>
        </div>
      </>
    )}
    {row.variant === 'ausziehen' && (
      <div class="t-ex" data-t-ex>
        <p class="t-ex-step mono" data-t-exstep aria-hidden="true">Stufe 0 von 4 · Zwischenspiel III</p>
        <div class="t-ex-grid">
          <div class="t-ex-fig"></div>
          <div class="t-ex-text">
            <p class="t-ex-h">Ich bin Niklas Prüfling.</p>
            <p class="t-ex-p">NP Webdesign ist mein Studio in Schwandorf. Ich komme aus der Technik und bringe die Haltung mit: erst verstehen, wie etwas funktionieren muss, dann bauen.</p>
            <p class="t-ex-p"><span class="t-ex-link">Mehr über meine Arbeitsweise</span> <span class="t-ex-btn">Projekt anfragen</span></p>
          </div>
        </div>
      </div>
    )}
    {row.variant === 'rohbau' && (
      <div class="t-rb" data-t-rb>
        <ol class="t-rb-grid" data-t-rbgrid>
          {builtWorlds.map((w) => (
            <li class="t-rb-i" data-world={w.nr} data-t-rbi>
              <span class="t-rb-raw" data-t-raw>Welt {w.nr} · {w.name}</span>
              <span class="wp-frame t-rb-np" data-t-np>
                <span class="wp-bar"><i></i><i></i><i></i><span class="wp-bar-label mono">Studie {w.nr}</span></span>
                <span class="wp-still"><WorldStill nr={w.nr} /></span>
              </span>
            </li>
          ))}
          <li class="t-rb-center" data-t-rbcenter><Logo class="wp-center-logo" /></li>
        </ol>
      </div>
    )}
    {row.variant === 'messraster' && (
      <div class="t-cal" data-world="08" data-t-cal>
        {TAGE.map((d) => <span class="t-cal-head" data-t-head>{d}</span>)}
        {ZELLEN.map((n) => <span class={`t-cal-cell${n === 17 ? ' is-termin' : ''}${n === null ? ' is-leer' : ''}`} data-t-cell data-termin={n === 17 ? '' : undefined}>{n}</span>)}
      </div>
    )}
    {row.variant === 'wasser' && (
      <div class="t-ws" data-t-ws>
        <div class="t-ws-frame" data-t-wsframe>
          <div class="t-ws-a" data-world="08" data-t-wsa><BildPlatzhalter id="w08-weiher" /></div>
          <div class="t-ws-b" data-world="09" data-t-wsb><BildPlatzhalter id="w09-see-abend" /></div>
        </div>
        <svg class="t-ws-line" viewBox="0 0 1000 12" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path data-t-wsline d="M0 6 C120 0 240 12 360 6 S600 0 720 6 S900 12 1000 6" pathLength="1" /></svg>
      </div>
    )}
    {row.variant === 'fenster' && (
      <div class="t-fn" data-t-fn>
        <div class="t-fn-window" data-world="09" data-t-window>
          <span class="t-fn-licht" data-t-licht></span>
          <span class="t-fn-steg t-fn-steg-v"></span><span class="t-fn-steg t-fn-steg-h"></span>
        </div>
      </div>
    )}
    {row.variant === 'scheinwerfer' && (
      <div class="t-lampwrap" data-world="06" data-t-lampwrap>
        <svg class="t-lamp-ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle data-t-ring cx="50" cy="50" r="48" pathLength="1" /></svg>
        <div class="t-lamp" data-t-lamp></div>
      </div>
    )}
    {row.variant === 'kreise' && (
      <svg class="t-kr" viewBox="0 0 1000 400" aria-hidden="true" focusable="false" data-t-kr>
        <ellipse data-t-e cx="500" cy="200" rx="60" ry="60" />
        <ellipse data-t-e cx="500" cy="200" rx="110" ry="110" />
        <ellipse data-t-e cx="500" cy="200" rx="160" ry="160" />
        {[0, 1, 2, 3, 4, 5].map((i) => <circle data-t-st cx={40 + i * 184} cy="200" r="9" />)}
      </svg>
    )}
    {row.variant === 'strahl' && (
      <>
        <div class="t-glow" data-t-glow></div>
        <svg class="t-st" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <line data-t-beam x1="40" y1="20" x2="960" y2="20" />
          {[0, 1, 2, 3, 4, 5].map((i) => <circle data-t-dot cx={40 + i * 184} cy="20" r="6" />)}
        </svg>
      </>
    )}
    {row.variant === 'zierlinie' && (
      <svg class="t-zl" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path data-t-zl d="M40 250 C300 250 380 250 560 250 S860 250 1000 250" pathLength="1" />
      </svg>
    )}
    {row.variant === 'nblende' && (
      <>
        <svg class="t-n-outline" data-t-outline viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polygon points="0,100 0,0 26,0 74,66 74,0 100,0 100,100 74,100 26,34 26,100" pathLength="1" /></svg>
        <div class="t-n-l" data-t-nl></div>
        <div class="t-n-d" data-t-nd></div>
        <div class="t-n-r" data-t-nr></div>
        <div class="t-fill" data-t-fill></div>
        <p class="t-kz" data-t-kz><span data-t-kein>Kein</span> <span data-t-kz-z>Zufall</span><span data-t-dot>.</span></p>
        <div class="t-final-wrap" data-world="04" data-t-finalwrap>
          <div class="t-final-in"><p class="w04-headline t-final" data-t-final><span data-t-pre>Nichts</span> <span data-t-pre>dem</span> <span data-t-final-z>Zufall</span> <span data-t-post>überlassen.</span></p></div>
        </div>
      </>
    )}
    {row.variant === 'bon' && (
      <div class="t-bon3d" data-t-bon>
        <div class="t-bon-card" data-t-card>
          <div class="t-bon-face t-bon-front" data-world="01">
            <p class="mono">Vorbestellung · Demo</p>
            <p class="t-bon-nr">Nr. 07</p>
          </div>
          <div class="t-bon-face t-bon-back" data-world="02">
            <p class="t-bon-head"><span>Messingstuhl</span><span>Wartemarke</span></p>
            <p class="t-bon-nr2">07</p>
          </div>
        </div>
        <svg class="t-bon-outline" data-t-outline viewBox="0 0 300 400" preserveAspectRatio="none"><rect x="1" y="1" width="298" height="398" pathLength="1" /></svg>
      </div>
    )}
  </div>
</section>
