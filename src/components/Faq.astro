---
/** FAQ und Footer (Blueprint E, J): keine Inszenierung. Natives <details>, funktioniert ohne JavaScript. */
import FaqListe from './FaqListe.astro';
const { row } = Astro.props;
---
<section id={row.anchor} class="faq" data-section={row.id} data-ground={row.ground} data-tone="light"
         data-counter="FAQ" data-counter-short="FAQ" data-bar-off aria-labelledby="faq-title">
  <div class="faq-inner">
    <h2 id="faq-title">Häufige Fragen</h2>
    <FaqListe />
  </div>
</section>
