---
/** Liste der häufigen Fragen (Startseite und Leistungen). Natives <details>, funktioniert ohne JavaScript. Fragen und Zahlen stehen in src/config/site.js. */
import { FAQ } from '../config/site.js';
---
<div class="faq-list">
  {FAQ.map((f) => (
    <details class="faq-item" name="faq">
      <summary><span>{f.q}</span><span class="faq-icon" aria-hidden="true"></span></summary>
      <p class="faq-a prose">{f.a}{f.link && <>{' '}<a href={f.link.href}>{f.link.label}</a>.</>}</p>
    </details>
  ))}
</div>
