---
/**
 * Einstieg von /welten: der Werkplan auf einer Bühne (Blueprint D, Kurskorrektur 11. Oktober 2026).
 * Den Hero gibt es hier nicht mehr, er gehört der Startseite. Der Werkplan steht von Anfang an, ruht kurz,
 * dann wächst die Zelle von Welt 01 auf Viewport-Größe (t00). Ruhig und ohne JavaScript: der Werkplan als Raster, die Zellen sind Links.
 */
import Werkplan from './Werkplan.astro';
---
<section id="opening" class="opening" data-section="opening" data-counter="Werkplan" data-ground="#F0EBE3" data-tone="light" aria-labelledby="werkplan-title">
  <span id="werkplan" class="anchor"></span>
  <div class="stage" data-stage>
    <h1 id="werkplan-title" class="visually-hidden">Neun Welten · Studien von NP Webdesign</h1>
    <Werkplan />

    <!-- t00: Die Zelle 01 wächst auf Viewport-Größe (Ausschnitt-Maske); nur Bühne, für Hilfstechnik verborgen -->
    <div class="grow" data-world="01" data-grow aria-hidden="true"><div class="grow-art"><picture>
      <source media="not all and (min-width: 1024px) and (pointer: fine)" srcset="/images/werkplan/welt-01-grow-m.webp">
      <img src="/images/werkplan/welt-01-grow-d.webp" width="1280" height="800" alt="" loading="lazy" decoding="async">
    </picture></div></div>
  </div>
</section>
