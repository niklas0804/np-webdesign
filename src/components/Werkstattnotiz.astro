---
/** Werkstattnotiz (Blueprint K): kleine Karte der NP-Schicht am Ende jeder Welt. NP-Schriften, NP-Farben, höchstens 45 Wörter. */
import { BRANCHEN_LIST } from '../content/branchen.js';
const { world: w, linkLabel = null } = Astro.props;
const page = BRANCHEN_LIST.find((b) => b.world === w.nr);
---
<aside class="note" aria-label={`Werkstattnotiz Welt ${w.nr}: ${w.name}`}>
  <p class="mono note-head">Welt {w.nr} · Studie · {w.branche}</p>
  <p class="note-text">{w.notiz}</p>
  <p class="mono note-tag">Leistung im Einsatz: {w.leistung}</p>
  {page && linkLabel && <a class="link note-link" href={w.branchPage}>{linkLabel}</a>}
</aside>
