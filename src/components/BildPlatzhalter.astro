---
/**
 * Neutrale Fläche im richtigen Seitenverhältnis mit dezentem „Foto folgt“ (statt einer gezeichneten Ersatzgrafik).
 * Das Briefing für den Fotografen (Motiv, Format, Einsatz, Rechte) steht in src/content/fotos.js und docs/fotoliste.md und wird NIE ausgeliefert.
 * Ist `status` 'da', gehört stattdessen ein echtes <img> in das Weltmodul.
 */
import { FOTOS } from '../content/fotos.js';
const { id, class: cls = '' } = Astro.props;
const f = FOTOS[id];
if (!f) throw new Error(`Bildplatzhalter: Eintrag „${id}“ fehlt in src/content/fotos.js`);
---
<figure class={`foto-platzhalter ${cls}`} data-foto={id} aria-hidden="true">
  <div class="fp-frame" data-ratio={f.ratio}>
    <p class="fp-tag">Foto folgt</p>
  </div>
</figure>
