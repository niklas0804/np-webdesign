---
/** Linienzeichnungen statt Fotos (Blueprint F: Low-Key, Gold). Eine Strichstärke, nur Gold. Rein dekorativ. */
const { form = 'schere', class: cls = '' } = Astro.props;
---
<svg class={`werkzeug werkzeug-${form} ${cls}`} viewBox="0 0 200 300" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {form === 'schere' && (<>
    <circle cx="60" cy="238" r="30" /><circle cx="140" cy="238" r="30" />
    <path d="M76 212 L134 22 L142 26 L108 214" /><path d="M124 212 L66 22 L58 26 L92 214" />
    <circle cx="100" cy="150" r="6" />
  </>)}
  {form === 'messer' && (<>
    <rect x="22" y="152" width="96" height="30" rx="15" />
    <path d="M116 160 L172 160 Q186 160 186 146 L186 76 Q132 100 116 152" />
    <circle cx="124" cy="167" r="5" />
    <path d="M22 167 L10 167" />
  </>)}
  {form === 'kamm' && (<>
    <rect x="22" y="100" width="156" height="36" rx="8" />
    {[38, 54, 70, 86, 102, 118, 134, 150, 166].map((x) => <path d={`M${x} 136 L${x} 190`} />)}
  </>)}
</svg>
