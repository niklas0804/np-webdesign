---
/**
 * Standard-Übergang (Blueprint T.3): Der orange Faden zieht eine Linie quer über den Viewport,
 * dahinter wischt die neue Welt herein. Länge kommt aus der Reise-Konfiguration.
 * Ruhige Variante: nur der Faden als feine Linie, kein Pin.
 */
const { row } = Astro.props;
---
<section class="transition" data-section={row.id} data-from-tone={row.fromTone} data-to-tone={row.toTone}
         data-from-ground={row.fromGround} data-to-ground={row.toGround} data-from-id={row.from} data-to-id={row.to} data-variant={row.variant || undefined} aria-hidden="true">
  <div class="t-stage">
    <div class="t-wipe"></div>
    <div class="t-thread"></div>
    {row.variant === 'goldlinie' && (
      <div class="t-mass" data-t-mass>
        <div class="t-gold" data-world="02" data-t-gold></div>
        <div class="t-blue" data-world="03" data-t-blue></div>
        <div class="t-dim" data-world="03" data-t-dim>
          <svg class="t-arrow t-arrow-l" viewBox="0 0 40 40" aria-hidden="true"><path d="M36 14 L8 20 L36 26 Z" /><path d="M6 6 V34" /></svg>
          <span class="t-dim-value">12.400</span>
          <svg class="t-arrow t-arrow-r" viewBox="0 0 40 40" aria-hidden="true"><path d="M4 14 L32 20 L4 26 Z" /><path d="M34 6 V34" /></svg>
        </div>
      </div>
    )}
    {row.variant === 'pruefstempel' && (
      <>
        <div class="t-iris" data-t-iris></div>
        <div class="t-seal" data-world="03" data-t-seal>
          <svg viewBox="0 0 160 160" focusable="false">
            <defs><path id="t-ring" d="M80 80 m-58 0 a58 58 0 1 1 116 0 a58 58 0 1 1 -116 0" /></defs>
            <g class="t-seal-ring" data-t-ringgroup>
              <circle cx="80" cy="80" r="74" fill="none" stroke="currentColor" stroke-width="4" />
              <text class="t-ring-text" data-t-ring-a><textPath href="#t-ring" startOffset="0" textLength="362" lengthAdjust="spacing">WITTGENFELD BAU · STUDIE · DEMO · </textPath></text>
              <text class="t-ring-text" data-t-ring-b><textPath href="#t-ring" startOffset="0" textLength="362" lengthAdjust="spacing">GEPRÜFT: KEIN BAUKASTEN · NP WEBDESIGN · </textPath></text>
            </g>
            <circle cx="80" cy="80" r="40" fill="none" stroke="currentColor" stroke-width="1.5" />
            <text class="t-seal-main" data-t-main-a x="80" y="88" text-anchor="middle">GEPRÜFT</text>
            <text class="t-seal-np" data-t-main-b x="80" y="94" text-anchor="middle">NP</text>
          </svg>
        </div>
      </>
    )}
    {row.variant === 'bon' && (
      <div class="t-bon3d" data-t-bon>
        <div class="t-bon-card" data-t-card>
          <div class="t-bon-face t-bon-front" data-world="01">
            <p class="mono">Vorbestellung · Demo</p>
            <p class="t-bon-nr">Nr. 07</p>
          </div>
          <div class="t-bon-face t-bon-back" data-world="02">
            <p class="t-bon-head"><span>Messingstuhl</span><span>Wartemarke</span></p>
            <p class="t-bon-nr2">07</p>
          </div>
        </div>
        <svg class="t-bon-outline" data-t-outline viewBox="0 0 300 400" preserveAspectRatio="none"><rect x="1" y="1" width="298" height="398" pathLength="1" /></svg>
      </div>
    )}
  </div>
</section>
